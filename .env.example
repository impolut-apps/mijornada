# Copia este archivo a .env y rellena con los datos de tu proyecto Supabase.
# Settings > API en el panel de Supabase. Estas dos claves son PÚBLICAS (van en el cliente).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# NUNCA pongas aquí la service_role key ni la contraseña de la escuela:
# esos secretos van en Supabase (Edge Functions / Secrets), nunca en el cliente ni en el repo.
